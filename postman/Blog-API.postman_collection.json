        {
          "name": "POST Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Returns the created post with a generated id', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.post.id).to.be.a('number');",
                  "    pm.expect(json.post.title).to.eql('My First Post From Postman');",
                  "    pm.expect(json.post).to.have.property('createdAt');",
                  "});",
                  "",
                  "// Save the new id so the PUT and DELETE requests can reuse it",
                  "const json = pm.response.json();",
                  "if (json.post && json.post.id) {",
                  "    pm.collectionVariables.set('createdPostId', String(json.post.id));",
                  "    console.log('Saved createdPostId =', json.post.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Post From Postman\",\n  \"body\": \"This post was created with the Postman collection.\",\n  \"author\": \"Postman Tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
