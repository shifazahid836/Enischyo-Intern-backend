# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# development | production
NODE_ENV=development

# Allowed browser origins for CORS (use * to allow all, or a comma separated list)
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# MongoDB Atlas connection string (REQUIRED — the API cannot start without it)
#
# Replace the placeholders below with the details of YOUR cluster. Nothing here
# is a real credential, which is exactly why this file is safe to commit.
#
# Where to find it: Atlas → your cluster → Connect → Drivers → Node.js
#
# The database name ("jobboard" below) is created automatically on first write.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/jobboard?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Authentication / JWT (REQUIRED for /auth/* and every protected route)
#
# JWT_SECRET signs every token. It must be at least 32 characters long —
# generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# This placeholder is NOT a real secret: replace it with your own random value.
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# How long an issued token stays valid (register / login). Default: 7 days.
# Examples: 15m, 1h, 7d, 30d
JWT_EXPIRES_IN=7d

# Set to true ONLY if you deliberately want POST /auth/register to accept
# role=admin. Keep it false: admins are created by seed.js or by another admin.
ALLOW_ADMIN_REGISTRATION=false
