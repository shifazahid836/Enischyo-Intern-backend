# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# ---------------------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# development | production
NODE_ENV=development

# Allowed browser origins for CORS (use * to allow all, or a comma separated list)
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# MongoDB Atlas connection string (REQUIRED — the API cannot start without it)
#
# Replace the placeholders below with the details of YOUR cluster. Nothing here
# is a real credential, which is exactly why this file is safe to commit.
#
# Where to find it: Atlas → your cluster → Connect → Drivers → Node.js
#
# The database name ("jobboard" below) is created automatically on first write.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_name>.mongodb.net/jobboard?retryWrites=true&w=majority
